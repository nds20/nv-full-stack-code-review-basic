# Copy this file to ".env" in this folder (or set the variables in your
# environment) and fill in real values. Never commit a real .env file.

# Port the API listens on. The React dev server proxies /api to this port
# (see "proxy" in ../package.json).
PORT=4000

# Admin credentials for the /admin area of the shop. Required — if these are
# not set, admin login is disabled and the API says so.
SMOKESHOP_ADMIN_USER=admin
SMOKESHOP_ADMIN_PASSWORD=change-me

# Optional but recommended: a long random string used to sign admin session
# tokens. If omitted, the signing key is derived from the admin password.
SMOKESHOP_ADMIN_SECRET=
